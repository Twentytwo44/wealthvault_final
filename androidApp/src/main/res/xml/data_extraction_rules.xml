<?xml version="1.0" encoding="utf-8"?>
<!-- Keep session credentials on-device; device metadata may still be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wealthvault_secure_session.xml" />
        <exclude domain="file" path="default.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wealthvault_secure_session.xml" />
        <exclude domain="file" path="default.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
